  "cards": [
    {
      "dot": "cyan",
      "title": "Routing",
      "items": [
        "Clients call model=laya-router; async_pre_call_hook rewrites data['model'] before LiteLLM dispatches.",
        "laya answers route and is_decision in a single forward pass over /v1/systemone."
      ]
    },
    {
      "dot": "emerald",
      "title": "Decision worker",
      "items": [
        "is_decision routes to DecisionWorker, a LiteLLM CustomLLM registered as decision/decision.",
        "The local SLM is grammar-constrained via response_format json_schema; a malformed answer fails loudly."
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy & fallback",
      "items": [
        "Local routes never fall back to a hosted API; RunPod is the only acceptable fallback for local workers.",
        "The gate is the winning option's own probability (MIN_PROB), not laya's confidence."
      ]
    }
  ]
